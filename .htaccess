# For hosts where the document root cannot be set to public/: this file
# sends every request into public/, so nothing else in this folder (config,
# storage, core, content) can be reached from the web. Setting the document
# root to public/ is better; this is the fallback.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, refuse everything rather than expose the site's files.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
