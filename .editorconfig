# Editor defaults for every file in Kestello. Formatting itself is enforced by
# PHP CS Fixer (PHP) and Prettier (JavaScript, Vue, CSS): npm run format
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,neon}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
