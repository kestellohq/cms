#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Kestello CLI. Same core resolution as public/index.php.
 */

$root = dirname(__DIR__);
$core = is_file($root . '/core/current.php')
    ? $root . '/core/releases/' . (require $root . '/core/current.php')
    : $root . '/core';

require $core . '/bootstrap.php';

// $_SERVER['argv'] rather than the $argv global, which static analysis on PHP 8.5 no longer assumes is set.
/** @var list<string> $arguments */
$arguments = $_SERVER['argv'] ?? [];

exit(Kestello\Kernel::create($root)->handleConsole($arguments));
