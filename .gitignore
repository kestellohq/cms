# Environment
.env

# Storage
storage/cache/*
storage/logs/*
storage/sessions/*
storage/compiled/*
storage/framework/*
storage/database/*
storage/app/*
storage/tmp/*
storage/fonts/*
storage/forms/*
storage/registry/*
!storage/*/.gitkeep

# Dependencies
# Only a root vendor/ folder; core/resources/assets/vendor (the vendored Vue) is committed.
/vendor/
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Config (generated by installer)
config/installed.php

# Site config generated by the installer (credentials, secret key)
config/*.php

# Local AI assistant settings (the shared instructions are AGENTS.md and .agents/)

# Site content: installed packages and uploads (only the base theme ships with core;
# plugins live in kestellohq/plugins, examples in kestellohq/examples)
content/plugins/*
!content/plugins/.gitkeep
content/themes/*
!content/themes/base/
!content/themes/exhibit/
content/uploads/*
!content/uploads/.gitkeep

# Runtime state (safe-mode suspensions …) and per-plugin data
storage/framework/
storage/plugins/

# Local design-tool state (Impeccable mocks, critiques, captures): never part of the project
/.impeccable/

.php-cs-fixer.cache
.phpstan/
.eslintcache

# Built Vue pages: made by `npm run build`, and by CI for every check and release zip
core/resources/assets/build/
content/themes/*/assets/build/

# Core release folders and the pointer (written by core updates)
core/releases/
core/current.php
dist/

# ide:helpers --stubs output (published with each release instead)
/kestello.stub.php
